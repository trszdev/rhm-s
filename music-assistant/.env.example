# Переменные стека. В Portainer они задаются в настройках стека, вручную — в файле .env.
# Файл .env не коммить. chmod 600 .env

# Auth key из админки Tailscale (Settings → Keys). Нужен только при первом входе.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Адрес сервера будет https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=music

# Логин и пароль для Amperfy. С аккаунтом Google не связаны.
SUBSONIC_USER=admin
# Сгенерировать: openssl rand -hex 24
SUBSONIC_PASSWORD=REPLACE_ME

# Двухбуквенный код страны, из которой сервер выходит в YouTube, например DE.
REGION=REPLACE_ME

# Куки YouTube Music. Дают полный доступ к аккаунту, в git не добавлять.
# Base64 от cookies.txt (формат Netscape), экспортированного после входа на music.youtube.com:
#   base64 < cookies.txt | tr -d '\n'
# Подойдёт и строка заголовка Cookie из DevTools: a=b; c=d
# Пустое значение оставляет куки, которые уже лежат в томе.
YTM_COOKIES=
