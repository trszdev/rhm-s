# Скопируй в .env и заполни. Файл .env не коммить. chmod 600 .env

# Auth key из админки Tailscale (Settings → Keys). Нужен только при первом входе.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Адрес сервера будет https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=music

# Пароль пользователя admin для веб-интерфейса и Amperfy. С аккаунтом Google не связан.
# Применяется только при первом запуске с пустой базой.
# Сгенерировать: openssl rand -hex 24
SUBSONIC_PASSWORD=REPLACE_ME

# Двухбуквенный код страны, из которой сервер выходит в YouTube, например DE.
REGION=REPLACE_ME

# Куки YouTube в .env не пишутся: их вставляют в веб-интерфейсе,
# раздел Профиль → YouTube Music.
