# Переменные стека sync. Скопируй в .env и заполни:
#   cp .env.example .env && chmod 600 .env
# Файл .env не коммитить (он уже указан в .gitignore корня репозитория).

# Пароль root для MariaDB. Сгенерировать: openssl rand -hex 24
DB_ROOT_PASSWORD=REPLACE_ME

# Администратор Seafile. Создаётся при первом запуске.
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=REPLACE_ME

# Auth key из админки Tailscale (Settings → Keys). Нужен только при первом входе.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Имя узла в tailnet. Адрес будет https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=sync

# Тот же адрес, что выше, полностью. Seafile подставляет его в ссылки.
# Пример: sync.tail1234.ts.net (без https://)
SEAFILE_SERVER_HOSTNAME=sync.REPLACE_ME.ts.net

# Часовой пояс для логов и расписания
TZ=Europe/Moscow

# Логин Яндекса и пароль приложения для WebDAV (не основной пароль от аккаунта).
# Создать: id.yandex.ru → Безопасность → Пароли приложений → тип «Диск (WebDAV)».
YANDEX_USER=your-login
YANDEX_APP_PASSWORD=REPLACE_ME

# Папка на Яндекс.Диске, куда пишется бекап (создаётся автоматически)
BACKUP_REMOTE_DIR=seafile-backup

# Как часто делать бекап, в часах
BACKUP_INTERVAL_HOURS=24

# Сколько дней хранить дампы баз. Файлы Seafile хранятся в одном зеркале.
BACKUP_RETENTION_DAYS=14

# true — бекапить файлы Seafile вместе с дампами баз, false — только базы
BACKUP_DATA=true

# Квота на пользователя в ГБ. Применяется командой из README.md после первого запуска.
SEAFILE_QUOTA_GB=10
