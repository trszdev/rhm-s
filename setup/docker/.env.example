# Скопируй в .env и заполни. Файл .env не коммить (он в .gitignore).
# chmod 600 .env

# Auth key из Tailscale admin console (Settings → Keys).
# Нужен только при первом запуске, дальше состояние лежит в volume ts-state.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Имя Portainer в tailnet → https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=portainer
